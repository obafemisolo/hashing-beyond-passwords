{
  "info": {
    "name": "Hashing Beyond Passwords",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Idempotent order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "order-request-1001"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"customer-42\",\n  \"productId\": \"proxy-plan-20gb\",\n  \"quantity\": 1,\n  \"amount\": 1500.0\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/hashing/idempotency/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "hashing",
            "idempotency",
            "orders"
          ]
        }
      }
    },
    {
      "name": "Hashed cache key",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/hashing/cache/products/search?q=Static%20UK%20Proxy&page=0&size=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "hashing",
            "cache",
            "products",
            "search"
          ],
          "query": [
            {
              "key": "q",
              "value": "Static UK Proxy"
            },
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "10"
            }
          ]
        }
      }
    },
    {
      "name": "Deterministic bucket",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/hashing/buckets/user-123?count=4",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "hashing",
            "buckets",
            "user-123"
          ],
          "query": [
            {
              "key": "count",
              "value": "4"
            }
          ]
        }
      }
    },
    {
      "name": "Sign webhook payload (demo only)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"event\":\"payment.completed\",\"amount\":5000}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/hashing/webhooks/sign-for-demo",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "hashing",
            "webhooks",
            "sign-for-demo"
          ]
        }
      }
    }
  ]
}